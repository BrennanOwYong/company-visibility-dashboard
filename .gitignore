.superpowers
# Runtime scaffolding regenerated by bin/factory-init.sh on every session.
# This repo is the factory source, not a project built by it — keep generated state out.
/factory.json
/AGENTS.md
/modules.json

# Per-project runtime state written while the factory runs
/kanban/*.md
/kanban/inbox/
/kanban/agents/
/kanban/aar/
/kanban/user-test-cards/
/kanban/*.jsonl
/kanban/*.log

# Runtime knowledge outputs (source docs like KIV.md and handoffs/ stay tracked)
/knowledge/user-flow.md
/knowledge/edge-cases.md
/knowledge/lessons.md
/knowledge/contracts/
/knowledge/prd/
/knowledge/spec/
/knowledge/platform/
/knowledge/architecture.md
/knowledge/build-plan.md
/knowledge/technical/feasibility/
/knowledge/technical/research/
/knowledge/pipeline.json

# Machine-local guard (temporary hiding measure); settings.json degrades to allow when absent
/bin/hook-guard-technical

# The product's own repo and its builder worktrees (product code never lives in the factory tree)
/product/
/worktrees/
kanban/
