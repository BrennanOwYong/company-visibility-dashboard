.superpowers
# Generated project-local runtime state.
/factory.json
/AGENTS.md
/modules.json

# Per-project runtime state written while the factory runs
/kanban/*.md
/kanban/inbox/
/kanban/agents/
/kanban/aar/
/kanban/user-test-cards/
/kanban/*.jsonl
/kanban/*.log

# Runtime knowledge outputs (source docs like KIV.md and handoffs/ stay tracked)
/knowledge/user-flow.md
/knowledge/edge-cases.md
/knowledge/lessons.md
/knowledge/contracts/
/knowledge/prd/
/knowledge/spec/
/knowledge/platform/
/knowledge/architecture.md
/knowledge/build-plan.md
/knowledge/technical/feasibility/
/knowledge/technical/research/
/knowledge/pipeline.json

# The product's own repo and its builder worktrees (product code never lives in the factory tree)
/product/
/worktrees/
/kanban/

# Project-local factory runtime. Durable product/architecture/delivery memory under docs/ is tracked.
/.factory/runtime/
/.factory/events/
/.factory/evaluations/
/factory-eval/

# Generated Python bytecode
__pycache__/
*.pyc

# Human-held setup values. The factory writes these directly and never commits them.
.env.local
.env.test.local
