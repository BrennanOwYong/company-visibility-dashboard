#!/bin/bash
# PreToolUse guard: a builder cannot edit the BRIEF of the ticket that spawns it — the
# frontmatter, Intent, Build, Success criteria, and Testing are the TS-authored contract it
# is judged against, so letting the builder rewrite them is reward-hacking the goalposts.
# Builders run in a tmux session named for their issue; spawn-builder sets $BUILDER_ISSUE in
# that env. The builder MAY still fill the completion sections (What was built / How it works /
# Tests run / Lessons) by Edit, and change status via kanban-update (a Bash call, not caught
# here). This guard only blocks a write that touches the brief. Exit 2 blocks + feeds back.

[ -n "$BUILDER_ISSUE" ] || exit 0            # only builders carry this; planners/PM pass through
INPUT="$(cat)"

# Only writes to the builder's OWN canonical ticket file are in scope.
printf '%s' "$INPUT" | grep -qE "kanban/+$BUILDER_ISSUE\.md" || exit 0

TOOL=$(printf '%s' "$INPUT" | grep -oE '"tool_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1)

# A full-file Write always risks the brief -> block outright.
if printf '%s' "$TOOL" | grep -q '"Write"'; then
  echo "Blocked: do not Write over kanban/$BUILDER_ISSUE.md — it holds your ticket brief (the contract you're judged against). Fill the completion sections with targeted Edits, set status via 'kanban-update $BUILDER_ISSUE <STATUS> \"<notes>\"'." >&2
  exit 2
fi

# An Edit is blocked only if it touches a brief region: frontmatter keys or brief headers.
if printf '%s' "$INPUT" | grep -qE '## (Intent|Build|Success criteria|Testing)|"(success|title|dependsOn|feature|milestone|intent|build|testing)"[[:space:]]*:|^(success|title|dependsOn|feature|milestone):'; then
  echo "Blocked: that edit touches the brief of kanban/$BUILDER_ISSUE.md (Intent/Build/Success criteria/Testing or frontmatter) — the contract you are built and validated against, authored by the planner. You may only fill the completion sections (What was built / How it works / Tests run / Lessons). If the brief is wrong, that is a TICKET-GAP for the planner, not yours to change." >&2
  exit 2
fi

exit 0
