#!/bin/bash
# Stop hook — PRD agent → technical planner auto-handoff.
# When the prd-agent session finishes a turn AND has signaled the PRD is complete
# (marker knowledge/prd/_COMPLETE), launch the technical planner once, then no-op.
# Identifies the agent from the Stop hook stdin (native: agent_type), falling back to
# the tmux session name. Always exits 0 so it never blocks the PM's turn.
# No-op outside an active factory session.
INPUT=$(cat 2>/dev/null)
ROOT=$(cat "$HOME/.claude/.coordinator-root" 2>/dev/null)
[ -z "$ROOT" ] && exit 0

AGENT_ID=$(printf '%s' "$INPUT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('agent_type',''))" 2>/dev/null)
[ -z "$AGENT_ID" ] && AGENT_ID=$(tmux display-message -p '#S' 2>/dev/null)
[ "$AGENT_ID" = "prd-agent" ] || exit 0

MARKER="$ROOT/knowledge/prd/_COMPLETE"
GUARD="$ROOT/kanban/.handoff-prd-done"
[ -f "$MARKER" ] || exit 0     # PRD not signaled complete yet
[ -f "$GUARD" ] && exit 0      # already handed off

mkdir -p "$ROOT/kanban"
touch "$GUARD"

DIR="$(cd "$(dirname "$0")" && pwd)"
KANBAN_PROJECT_ROOT="$ROOT" "$DIR/factory-log" handoff from=prd-agent to=technical-planning-agent trigger=stop_hook
KANBAN_PROJECT_ROOT="$ROOT" "$DIR/spawn-agent" technical-planning-agent \
  "The PRD is ready in knowledge/prd/ (and acceptance contracts in knowledge/contracts/acceptance/ if present). Produce the validated technical plan (per-feature plans, derived architecture, interface contracts), pass your validation gate, then invoke the roadmap-and-branching skill to hydrate the kanban board with branches and tickets." \
  >> "$ROOT/kanban/handoff.log" 2>&1
exit 0
