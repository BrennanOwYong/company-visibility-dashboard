#!/usr/bin/env node
// kanban-graph [--json]
//
// A kanban PRIMITIVE. Reads kanban/*.md and reports the dependency graph the architect
// built from the roadmap: dependency levels (each ticket starts the moment its prerequisites are DONE), dependency cycles,
// dangling dependencies, and unresolved external-infra needs. Lets the architect verify
// the roadmap it just created before anything is dispatched.

const fs = require('fs');
const path = require('path');

const JSON_MODE = process.argv.includes('--json');
const EMIT_ONLY = process.argv.includes('--emit');   // refresh kanban/graph.json, print nothing
const root = process.env.KANBAN_PROJECT_ROOT || process.cwd();
const dir = path.join(root, 'kanban');

if (!fs.existsSync(dir)) { console.error('No kanban dir:', dir); process.exit(0); }

function frontmatter(text) {
  const m = text.match(/^---\n([\s\S]*?)\n---/);
  const fm = {};
  if (!m) return fm;
  for (const line of m[1].split('\n')) {
    const i = line.indexOf(':');
    if (i === -1) continue;
    fm[line.slice(0, i).trim()] = line.slice(i + 1).trim();
  }
  return fm;
}
const list = v => (v || '').split(',').map(s => s.replace(/[\[\]"]/g, '').trim()).filter(Boolean);

const issues = {};
for (const f of fs.readdirSync(dir)) {
  if (!f.endsWith('.md') || f.endsWith('-card.md') || f.endsWith('-aar.md')) continue;
  const fm = frontmatter(fs.readFileSync(path.join(dir, f), 'utf8'));
  const id = fm.issue || f.replace(/\.md$/, '');
  issues[id] = {
    id, feature: fm.feature || '', title: fm.title || '', status: fm.status || 'NOT_STARTED',
    milestone: fm.milestone || '', dependsOn: list(fm.dependsOn), needsInfra: list(fm.needsInfra),
    needs_user_test: (fm.needs_user_test || 'true').trim() !== 'false',
    missingCritical: ['build', 'success_criteria'].filter(k => !(fm[k] || '').trim()),
  };
}
const ids = Object.keys(issues);

// Dangling deps — dependsOn pointing at an issue that does not exist
const dangling = [];
for (const id of ids) for (const d of issues[id].dependsOn) if (!issues[d]) dangling.push({ issue: id, missing: d });

// Topological levels (Kahn). Level = longest dependency chain to this issue → build wave.
const indeg = {}; ids.forEach(i => indeg[i] = 0);
for (const id of ids) for (const d of issues[id].dependsOn) if (issues[d]) indeg[id]++;
const level = {};
const queue = ids.filter(i => indeg[i] === 0);
queue.forEach(i => level[i] = 0);
const indeg2 = { ...indeg };
let processed = 0;
const q = [...queue];
while (q.length) {
  const cur = q.shift(); processed++;
  for (const id of ids) {
    if (issues[id].dependsOn.includes(cur) && issues[cur]) {
      indeg2[id]--;
      level[id] = Math.max(level[id] || 0, (level[cur] || 0) + 1);
      if (indeg2[id] === 0) q.push(id);
    }
  }
}
const hasCycle = processed < ids.length;
const cyclic = ids.filter(i => !(i in level));

const waves = {};
for (const id of ids) if (id in level) (waves[level[id]] = waves[level[id]] || []).push(id);

const infra = {};
for (const id of ids) for (const inf of issues[id].needsInfra) (infra[inf] = infra[inf] || []).push(id);

// Materialize the dependency DAG as a first-class graph object.
// Edges are DIRECTIONAL prerequisite→dependent: {from: prerequisite, to: dependent} means
// `from` must be FULFILLED before `to` may start — i.e. the prerequisite points AT the dependent.
// Each node is gated by an AND over every prerequisite that points at it: it becomes `ready` only
// when ALL of its `requires` are fulfilled (a node with 2+ deps waits for every one — never any).
// `fulfilled` := status is DONE (built + merged). Optional/OR dependencies are not modeled here;
// if a future plan needs them, the roadmap skill decides and this gate is where they'd live.
// Persisted to kanban/graph.json on every run, refreshed by kanban-create / kanban-update.
// (Distinct from pipeline.json, which tracks each FEATURE's requirements/feasibility stage.)
const isFulfilled = id => !!issues[id] && issues[id].status === 'DONE';
const nodes = ids.map(id => {
  const requires = issues[id].dependsOn.filter(d => issues[d]);   // known prerequisites
  return {
    id, feature: issues[id].feature, title: issues[id].title, status: issues[id].status,
    needs_user_test: issues[id].needs_user_test, milestone: issues[id].milestone,
    wave: (id in level) ? level[id] : null,
    requires, gate: 'AND',
    fulfilled: isFulfilled(id),
    ready: requires.every(isFulfilled),   // AND gate: every prerequisite fulfilled
  };
});
const edges = [];
for (const id of ids) for (const d of issues[id].dependsOn) if (issues[d]) edges.push({ from: d, to: id, rel: 'prerequisite_of' });

const graph = {
  generatedFrom: 'kanban tickets (dependsOn frontmatter)',
  edgeSemantics: 'from=prerequisite, to=dependent; a node starts only when ALL prerequisites (its `requires`, gate=AND) are fulfilled (DONE)',
  nodes, edges,
  waves: Object.fromEntries(Object.entries(waves).map(([w, arr]) => [w, arr])),
  hasCycle, cyclic, dangling, infra,
};
try {
  fs.writeFileSync(path.join(dir, 'graph.json'), JSON.stringify(graph, null, 2));
} catch (e) { /* read-only fs or race — the console/validation output below still works */ }

if (EMIT_ONLY) process.exit(0);   // graph.json refreshed; caller wants no console output

const result = { issues, waves, dangling, hasCycle, cyclic, infra, nodes, edges };
if (JSON_MODE) { console.log(JSON.stringify(result, null, 2)); process.exit(0); }

console.log('\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
console.log(`KANBAN GRAPH — ${path.basename(root)}  (${ids.length} issues)`);
console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');

console.log('\n── DEPENDENCY LEVELS — a ticket starts the moment ALL its prerequisites are DONE (never batched) ──');
console.log('Level = longest prerequisite chain. Level 0 = ready now. Same-level issues share no dependency and can run in parallel, but each starts as soon as its own prerequisites complete.');
const waveNums = Object.keys(waves).map(Number).sort((a, b) => a - b);
for (const w of waveNums) {
  console.log(`\n  Level ${w}`);
  for (const id of waves[w]) {
    const it = issues[id];
    const deps = it.dependsOn.length ? `  depends:[${it.dependsOn.join(', ')}]` : '';
    const inf = it.needsInfra.length ? `  infra:[${it.needsInfra.join(', ')}]` : '';
    console.log(`    [${id}] ${it.title || it.feature}${deps}${inf}`);
  }
}

if (Object.keys(infra).length) {
  console.log('\n── EXTERNAL INFRA NEEDED (user must set up → NEEDS_SETUP) ─────');
  for (const [inf, who] of Object.entries(infra)) console.log(`  ${inf}  ← ${who.join(', ')}`);
}

const incomplete = ids.filter(i => issues[i].missingCritical.length);
if (incomplete.length) {
  console.log('\n── ⚠ TICKET COMPLETENESS — blank critical link fields ────────');
  for (const id of incomplete) console.log(`  [${id}] missing: ${issues[id].missingCritical.join(', ')}`);
} else {
  console.log('\n── TICKET COMPLETENESS ───────────────────────────────────────');
  console.log('  ✓ every ticket links build + success_criteria');
}

if (dangling.length) {
  console.log('\n── ⚠ DANGLING DEPENDENCIES ───────────────────────────────────');
  for (const d of dangling) console.log(`  [${d.issue}] depends on [${d.missing}] which does not exist`);
}

if (hasCycle) {
  console.log('\n── ⚠ DEPENDENCY CYCLE ────────────────────────────────────────');
  console.log(`  Issues in a cycle (cannot be ordered): ${cyclic.join(', ')}`);
}

if (!dangling.length && !hasCycle) console.log('\n  ✓ graph is acyclic with no dangling dependencies');
console.log('\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n');
