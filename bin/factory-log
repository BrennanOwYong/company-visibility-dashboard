#!/bin/bash
# factory-log <event> [key=value ...]
# Appends a timestamped JSON event to kanban/agent-events.jsonl. This is the telemetry
# stream for verifying the autonomous pipeline (handoffs, spawns) actually fires without
# manual intervention. Read it with: cat kanban/agent-events.jsonl
ROOT="${KANBAN_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
[ -z "$ROOT" ] && exit 0
EVENT="$1"; shift || true
[ -z "$EVENT" ] && exit 0
mkdir -p "$ROOT/kanban"
TS=$(date +%s%3N 2>/dev/null || echo 0)
python3 - "$TS" "$EVENT" "$@" <<'PY' >> "$ROOT/kanban/agent-events.jsonl"
import json, sys, time
ts = int(sys.argv[1]); event = sys.argv[2]
d = {"ts": ts, "iso": time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(ts/1000)), "event": event}
for kv in sys.argv[3:]:
    if "=" in kv:
        k, v = kv.split("=", 1); d[k] = v
print(json.dumps(d))
PY
