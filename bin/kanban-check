#!/bin/bash
# kanban-check — render current board state
PROJECT_ROOT="${KANBAN_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null)}"
KANBAN_DIR="$PROJECT_ROOT/kanban"

if [ ! -d "$KANBAN_DIR" ]; then
  echo "No kanban directory at $KANBAN_DIR"
  exit 1
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo " KANBAN — $(basename $PROJECT_ROOT)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

for STATUS in IN_PROGRESS NEEDS_ACTION BLOCKED_ON BUILT COMPLETE; do
  FILES=$(grep -rl "^status: $STATUS" "$KANBAN_DIR" 2>/dev/null | grep -v user-test-cards | grep -v aar || true)
  if [ -n "$FILES" ]; then
    echo ""
    echo "  $STATUS"
    while IFS= read -r f; do
      ISSUE=$(basename "$f" .md)
      FEATURE=$(grep "^feature:" "$f" | awk '{print $2}')
      PORT=$(grep "^port:" "$f" | awk '{print $2}')
      LAST=$(grep "^### " "$f" | tail -1 | sed 's/### //')
      echo "    [$ISSUE] feature:$FEATURE  port:$PORT  last: $LAST"
    done <<< "$FILES"
  fi
done

# Show pending test cards
CARDS=$(ls "$KANBAN_DIR/user-test-cards/"*.md 2>/dev/null | grep -v group || true)
if [ -n "$CARDS" ]; then
  echo ""
  echo "  AWAITING USER TEST"
  while IFS= read -r c; do
    echo "    $(basename $c)"
  done <<< "$CARDS"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
