#!/bin/bash
# kanban-aar <issue> [after-action-notes]
# Assembles the after-action report from the ticket's completion sections and appends
# non-obvious lessons to knowledge/lessons.md. Called by rebase-queue once the branch
# lands on main (the AAR records shipped work, not approved-but-unmerged work).
# Idempotent: re-running overwrites the AAR file and skips the lessons append if the
# issue's entry is already present.
set -e

ISSUE="$1"
AAR_NOTES="${2:-}"
PROJECT_ROOT="${KANBAN_PROJECT_ROOT:-$(cat "$HOME/.claude/.coordinator-root" 2>/dev/null || pwd)}"
KANBAN_DIR="$PROJECT_ROOT/kanban"
KANBAN_FILE="$KANBAN_DIR/$ISSUE.md"
LESSONS_FILE="$PROJECT_ROOT/knowledge/lessons.md"

if [ -z "$ISSUE" ]; then
  echo "Usage: kanban-aar <issue> [notes]"
  exit 1
fi
if [ ! -f "$KANBAN_FILE" ]; then
  echo "No kanban entry: $KANBAN_FILE"
  exit 1
fi

# Every extraction is guarded with `|| true`: grep exits 1 on no match, and under set -e
# an empty section would otherwise kill the whole report.
FEATURE=$(grep "^feature:" "$KANBAN_FILE" | awk '{print $2}' || true)
USER_FEEDBACK=$(awk '/^## Feedback from user/{found=1; next} /^## /{found=0} /^### /{found=0} found{print}' "$KANBAN_FILE" | grep -v '^(none)' | grep -v '^$' | head -5 || true)

WHAT_BUILT=$(awk '/^## What was built/{found=1; next} /^## /{found=0} found{print}' "$KANBAN_FILE" | grep -v '^(builder fills' | grep -v '^$' || true)
HOW_WORKS=$(awk '/^## How it works/{found=1; next} /^## /{found=0} found{print}' "$KANBAN_FILE" | grep -v '^(builder fills' | grep -v '^$' || true)
TESTS=$(grep "^- \[x\]" "$KANBAN_FILE" 2>/dev/null | head -20 || echo "(none recorded)")
LESSONS=$(awk '/^## Lessons learned/{found=1; next} /^## /{found=0} found{print}' "$KANBAN_FILE" | grep -v '^(builder fills' | grep -v '^$' || true)

AAR_FILE="$KANBAN_DIR/aar/$ISSUE-aar.md"
mkdir -p "$KANBAN_DIR/aar"

cat > "$AAR_FILE" << EOF
# After-Action Report — $ISSUE
**Feature:** $FEATURE
**Landed on main:** $(date '+%Y-%m-%d %H:%M')
**User feedback:** ${USER_FEEDBACK:-approved}

## What was built
$WHAT_BUILT

## How it works
$HOW_WORKS

## Tests verified
$TESTS

## Lessons learned
${LESSONS:-(none recorded)}

## Additional notes
${AAR_NOTES:-(none)}
EOF

echo "After-action report written: $AAR_FILE"

if [ -n "$LESSONS" ] && ! grep -q "— $ISSUE (" "$LESSONS_FILE" 2>/dev/null; then
  mkdir -p "$PROJECT_ROOT/knowledge"
  printf '\n---\n### %s — %s (%s)\n%s\n' \
    "$(date '+%Y-%m-%d')" "$ISSUE" "$FEATURE" "$LESSONS" >> "$LESSONS_FILE"
  echo "Lessons appended to knowledge/lessons.md"
fi
