#!/bin/bash
# Run the builder-declared argv verifier for one setup field.
set -euo pipefail
ISSUE=${1:-}; FIELD=${2:-}
ROOT=${KANBAN_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}
CONTRACT="$ROOT/.factory/runtime/setup-contracts/$ISSUE.json"
[ -f "$CONTRACT" ] || { echo 'No setup input contract exists for this ticket.'; exit 1; }
python3 - "$ROOT" "$CONTRACT" "$FIELD" <<'PY'
import json,os,subprocess,sys
root,contract,field=sys.argv[1:]
entry=next((item for item in json.load(open(contract,encoding='utf-8')).get('fields',[]) if item.get('id')==field),None)
if not entry: raise SystemExit('Unknown setup field.')
argv=entry.get('verify',[])
if not argv: raise SystemExit('No verifier is declared for this input.')
exe=os.path.realpath(os.path.join(root,argv[0]))
if not exe.startswith(os.path.realpath(root)+os.sep) or not os.path.isfile(exe): raise SystemExit('Verifier must be a project executable.')
result=subprocess.run([exe,*argv[1:]],cwd=root,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
if result.returncode: raise SystemExit(entry.get('failure_message','Verification failed.'))
print('Verification passed.')
PY
KANBAN_PROJECT_ROOT="$ROOT" "$ROOT/bin/factory-log" setup_verified issue="$ISSUE" field="$FIELD" || true
KANBAN_PROJECT_ROOT="$ROOT" "$ROOT/bin/factory-notify" "$ISSUE" "External setup condition '$FIELD' is verified. Continue the ticket." || true
