#!/usr/bin/env python3
"""Store one stdin value according to an approved setup contract. Print no value."""
import json,os,re,sys,tempfile
root,contract,field=sys.argv[1:]
value=sys.stdin.read(1024*1024)
if not value: raise SystemExit('A value is required.')
data=json.load(open(contract,encoding='utf-8'))
entry=next((item for item in data.get('fields',[]) if item.get('id')==field),None)
if not entry: raise SystemExit('Unknown setup field.')
target=entry.get('target',{})
if target.get('type')!='env' or target.get('file') not in ('.env.local','.env.test.local'):
    raise SystemExit('The setup target is not approved.')
key=target.get('key','')
if not re.fullmatch(r'[A-Z][A-Z0-9_]*',key): raise SystemExit('Invalid environment key.')
path=os.path.realpath(os.path.join(root,target['file']))
if os.path.dirname(path)!=os.path.realpath(root): raise SystemExit('Environment target escaped the project root.')
lines=open(path,encoding='utf-8').read().splitlines() if os.path.exists(path) else []
line=key+'='+value.replace('\r','').replace('\n','')
lines=[old for old in lines if not old.startswith(key+'=')]+[line]
fd,tmp=tempfile.mkstemp(dir=root,prefix='.setup-value-',text=True)
with os.fdopen(fd,'w',encoding='utf-8') as h: h.write('\n'.join(lines)+'\n')
os.chmod(tmp,0o600); os.replace(tmp,path)
