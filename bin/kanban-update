#!/bin/bash
# kanban-update <issue> <status> [notes]
# Canonical state vocabulary (in pipeline order):
#   NOT_STARTED   — ticket exists, agent has not begun
#   IN_PROGRESS   — the whole build-validate feedback loop: builder builds, self-tests,
#                   requests independent validation, iterates on VALIDATION-FAILED (shift-left:
#                   everything objective resolves inside this state)
#   NEEDS_SETUP   — built but blocked on something outside the builder's control (external
#                   integration, credential, failing tool) with the builder's remarks on
#                   exactly what it needs
#   NEEDS_TESTING — validation passed; ONLY user experience and taste remain. Assigns a port,
#                   generates the test card, pings the coordinator.
#   DONE          — user approved; tested and ready for PR/merge (use kanban-done)
set -e

ISSUE="$1"
STATUS="$2"
NOTES="${3:-}"
PROJECT_ROOT="${KANBAN_PROJECT_ROOT:-$(pwd)}"
KANBAN_FILE="$PROJECT_ROOT/kanban/$ISSUE.md"
TELEMETRY_FILE="$PROJECT_ROOT/kanban/telemetry.jsonl"

if [ -z "$ISSUE" ] || [ -z "$STATUS" ]; then
  echo "Usage: kanban-update <issue> <status> [notes]"
  exit 1
fi

if [ ! -f "$KANBAN_FILE" ]; then
  echo "No kanban entry: $KANBAN_FILE"
  exit 1
fi

PREV_STATUS=$(grep "^status:" "$KANBAN_FILE" | awk '{print $2}')

# Deterministic gate (error-to-rule, from validation run 2026-07-04): a NEEDS_TESTING ticket
# with a blank test_command is untestable by a stranger — the validator caught this once with
# LLM effort; this check catches it forever for free. The builder must set test_command first.
if [ "$STATUS" = "NEEDS_TESTING" ]; then
  TC=$(grep "^test_command:" "$KANBAN_FILE" | head -1 | sed 's/^test_command:[[:space:]]*//')
  if [ -z "$TC" ]; then
    echo "[$ISSUE] REFUSED NEEDS_TESTING: test_command is blank in $KANBAN_FILE frontmatter."
    echo "Set it to the command/URL that brings up this feature's test state, then retry."
    exit 1
  fi
  if grep -q "(builder fills this in" "$KANBAN_FILE"; then
    echo "[$ISSUE] REFUSED NEEDS_TESTING: completion sections in $KANBAN_FILE still hold placeholders."
    echo "Fill What was built / How it works / Tests run / Lessons learned IN THIS FILE (HANDOFF.md is a read-only briefing copy), then retry."
    exit 1
  fi
  TREPO=$(grep -m1 "^repo:" "$KANBAN_FILE" | sed 's/^repo:[[:space:]]*//')
  TREPO="${TREPO:-$PROJECT_ROOT}"
  WT=$(git -C "$TREPO" worktree list --porcelain 2>/dev/null | awk '/^worktree /{p=$2} /^branch .*feat\/'"$ISSUE"'$/{print p}' | head -1)
  if [ -n "$WT" ] && [ -n "$(git -C "$WT" status --porcelain 2>/dev/null)" ]; then
    echo "[$ISSUE] REFUSED NEEDS_TESTING: uncommitted/untracked changes in worktree $WT."
    echo "Commit your work on feat/$ISSUE first — an unmerged, uncommitted build can be lost when the worktree is pruned."
    exit 1
  fi
  # Shift-left: NEEDS_TESTING means ONLY taste remains, so independent validation must have
  # passed while the ticket was still IN_PROGRESS.
  VFILE="$PROJECT_ROOT/kanban/validation/$ISSUE.md"
  if ! grep -qE '^verdict: pass' "$VFILE" 2>/dev/null; then
    echo "[$ISSUE] REFUSED NEEDS_TESTING: no passing validation verdict at $VFILE."
    echo "Spawn the validator while IN_PROGRESS (spawn-agent validator-agent \"VALIDATE: $ISSUE — ...\"), iterate on its VALIDATION-FAILED feedback, retry when it passes."
    exit 1
  fi
fi

sed -i "s/^status: .*/status: $STATUS/" "$KANBAN_FILE"

printf '\n### %s — %s\n%s\n' "$(date '+%Y-%m-%d %H:%M')" "$STATUS" "${NOTES:-no notes}" >> "$KANBAN_FILE"

TS=$(date +%s%3N 2>/dev/null || python3 -c "import time; print(int(time.time()*1000))" 2>/dev/null || echo "0")
printf '{"ts":%s,"issue":"%s","from":"%s","to":"%s","notes":%s}\n' \
  "$TS" "$ISSUE" "${PREV_STATUS:-NONE}" "$STATUS" \
  "$(printf '%s' "${NOTES:-}" | python3 -c "import json,sys; print(json.dumps(sys.stdin.read()))" 2>/dev/null || echo '"'"$NOTES"'"')" \
  >> "$TELEMETRY_FILE"

echo "[$ISSUE] $STATUS${NOTES:+ — $NOTES}"

KANBAN_PROJECT_ROOT="$PROJECT_ROOT" factory-log task_update issue="$ISSUE" status="$STATUS" from="${PREV_STATUS:-NONE}"

# The port is allocated when the validator boots (kanban-port, via spawn-agent's
# VALIDATE path) — validation runs inside IN_PROGRESS, so by NEEDS_TESTING the ticket
# normally holds one already. kanban-port is idempotent; this call only covers a
# validator that was run outside spawn-agent.
if [ "$STATUS" = "NEEDS_TESTING" ]; then
  PORT=$(KANBAN_PROJECT_ROOT="$PROJECT_ROOT" kanban-port "$ISSUE")

  KANBAN_PROJECT_ROOT="$PROJECT_ROOT" kanban-generate-card "$ISSUE"
  COORDINATOR=$(cat ~/.claude/.coordinator 2>/dev/null)
  CARD="$PROJECT_ROOT/kanban/user-test-cards/$ISSUE-card.md"
  [ -n "$COORDINATOR" ] && KANBAN_PROJECT_ROOT="$PROJECT_ROOT" tmux-delegate "$COORDINATOR" \
    "[$ISSUE] NEEDS_TESTING (port $PORT) — user test card ready for review: $CARD"
fi
