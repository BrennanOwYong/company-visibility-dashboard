#!/bin/bash
# inbox-drain <agent>
# Delivers exactly ONE queued message to an agent, and only if it is idle
# (done talking) with a live tmux session. The agent goes busy on delivery and
# drains the next message when it next finishes talking (its Stop hook calls this).
# This is the readiness gate: no message ever lands on a mid-turn agent.
AGENT="$1"
ROOT="${KANBAN_PROJECT_ROOT:-$(cat "$HOME/.claude/.coordinator-root" 2>/dev/null)}"

if [ -z "$ROOT" ] || [ -z "$AGENT" ]; then
  exit 0
fi

STATE_FILE="$ROOT/kanban/agents/$AGENT.state"
INBOX="$ROOT/kanban/inbox/$AGENT.jsonl"

[ -s "$INBOX" ] || exit 0

STATE=$(cat "$STATE_FILE" 2>/dev/null)

# Self-heal an orphaned 'delivering': the marker is only meant to live for one ack window
# (~2 min). If the drain that wrote it died mid-window (killed parent process, crashed
# shell), the state wedges and every future drain backs off forever — the whole inbox
# starves. A 'delivering' older than 5 minutes cannot be a live delivery; treat as idle.
if [ "$STATE" = "delivering" ]; then
  AGE=$(( $(date +%s) - $(stat -c %Y "$STATE_FILE" 2>/dev/null || echo 0) ))
  [ "$AGE" -gt 300 ] && STATE="idle"
fi

[ "$STATE" = "idle" ] || exit 0

tmux has-session -t "$AGENT" 2>/dev/null || exit 0

MSG_JSON=$(head -n1 "$INBOX")
[ -z "$MSG_JSON" ] && exit 0

# Pop the line we are about to deliver
tail -n +2 "$INBOX" > "$INBOX.tmp" 2>/dev/null && mv "$INBOX.tmp" "$INBOX"

MSG=$(printf '%s' "$MSG_JSON" | python3 -c "import json,sys; print(json.load(sys.stdin)['msg'])" 2>/dev/null)
[ -z "$MSG" ] && exit 0

# Mark 'delivering' so a racing drain backs off (only idle sessions receive).
printf 'delivering\n' > "$STATE_FILE"

# -l sends the text literally (no tmux key-name interpretation); Enter submits it
tmux send-keys -t "$AGENT" -l -- "$MSG"
sleep 1
tmux send-keys -t "$AGENT" Enter

# Test-mode short-circuit: with a stubbed CLI (CLAUDE_BIN != claude, e.g. smoke-test) there is no
# real TUI to show an active-turn marker, so the poll below would spin the full window on every
# delivery. The stub only needs the send-keys to have fired; mark busy and return.
if [ "${CLAUDE_BIN:-claude}" != "claude" ]; then
  printf 'busy\n' > "$STATE_FILE"
  echo "[drain] (test stub) delivered -> $AGENT"
  exit 0
fi

# Submission is confirmed by the TUI's OWN active-turn marker, not by the state file. The
# canonical delivery bug: when the Enter is swallowed (a boot/redraw/modal was showing when the
# text was typed, so keystrokes never reached the input box), the UserPromptSubmit hook never
# fires and a state-flip-only detector marks the agent busy anyway — a false-busy wedge that
# loses the message. Instead poll for "a turn actually started":
#   - the running-turn markers ("esc to interrupt" / the "· ↓ N tokens)" counter) — these appear
#     ONLY while a turn is live, so their presence is an unambiguous positive ack; OR
#   - the state file flipping off 'delivering' (the busy hook fired) — same conclusion.
# If neither yet, decide stranded-vs-never-landed WITHOUT the old false-match risk: that risk only
# existed because the old code matched the snippet with no active-turn gate, so a live turn's echo
# looked like a stranding. Here the snippet check runs ONLY when no turn is active (so nothing was
# submitted): snippet present => stranded in the box => Enter; snippet absent => never landed
# (swallowed) => RE-TYPE the whole message.
MARKERS='esc to interrupt|· ↓|tokens)'
SNIPPET=$(printf '%s' "$MSG" | cut -c1-20)
DELIVERED=0
for _ in $(seq 1 30); do
  sleep 4
  [ "$(cat "$STATE_FILE" 2>/dev/null)" != "delivering" ] && { DELIVERED=1; break; }
  PANE=$(tmux capture-pane -pJ -t "$AGENT" -S -12 2>/dev/null)
  if printf '%s' "$PANE" | grep -qE "$MARKERS"; then DELIVERED=1; break; fi   # a turn is live
  if printf '%s' "$PANE" | grep -qF "$SNIPPET"; then
    tmux send-keys -t "$AGENT" Enter                                          # stranded -> submit
  else
    tmux send-keys -t "$AGENT" -l -- "$MSG"; sleep 1; tmux send-keys -t "$AGENT" Enter   # never landed -> retype
  fi
done

if [ "$DELIVERED" = 1 ]; then
  # A turn is running. Resolve 'delivering' to 'busy' now (do not leave it: a >5min turn would
  # otherwise trip the delivering-orphan self-heal and let a second message land mid-turn). The
  # target's own Stop hook writes 'idle' at turn end and drains the next message.
  printf 'busy\n' > "$STATE_FILE"
  echo "[drain] delivered -> $AGENT"
else
  # Genuine failure: no turn ever started (a persistent modal, a dead pane). Do NOT mark busy —
  # that is the wedge. Requeue to the FRONT of the inbox and reset to 'idle' so the next drain
  # (Stop hook / dispatch) retries; log loudly. A message truly undeliverable stays visibly queued
  # instead of vanishing.
  TMP="$INBOX.$$"; printf '%s\n' "$MSG_JSON" > "$TMP"; cat "$INBOX" >> "$TMP" 2>/dev/null; mv "$TMP" "$INBOX"
  printf 'idle\n' > "$STATE_FILE"
  echo "[drain] FAILED to deliver to $AGENT after window — requeued, left idle for retry" >&2
fi
