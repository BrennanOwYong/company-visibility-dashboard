#!/bin/bash
# UserPromptSubmit hook — a prompt just entered this session (typed or delegated),
# so the agent is now busy talking. Marks it busy so no message is injected mid-turn.
# Never blocks (exit 0). No-op outside an active factory tmux session.
ROOT=$(cat "$HOME/.claude/.coordinator-root" 2>/dev/null)
[ -z "$ROOT" ] && exit 0

# Only act from INSIDE a tmux client (see hook-agent-idle): outside one, display-message
# returns an arbitrary live session's name and this hook stamps the wrong agent busy.
[ -z "$TMUX" ] && exit 0

SESSION=$(tmux display-message -p '#S' 2>/dev/null)
[ -z "$SESSION" ] && exit 0

DIR="$(cd "$(dirname "$0")" && pwd)"
KANBAN_PROJECT_ROOT="$ROOT" "$DIR/agent-state" "$SESSION" busy
exit 0
