#!/bin/bash
# kanban-done <issue> <user-feedback> [after-action-notes]
# Coordinator calls this AFTER the user approves the test card.
# Writes the after-action-report, extracts lessons, closes the ticket, checks dependency cluster.
set -e

ISSUE="$1"
USER_FEEDBACK="${2:-approved}"
AAR_NOTES="${3:-}"
PROJECT_ROOT="${KANBAN_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null)}"
KANBAN_DIR="$PROJECT_ROOT/kanban"
KANBAN_FILE="$KANBAN_DIR/$ISSUE.md"
LESSONS_FILE="$PROJECT_ROOT/knowledge/lessons.md"

if [ ! -f "$KANBAN_FILE" ]; then
  echo "No kanban entry: $KANBAN_FILE"
  exit 1
fi

FEATURE=$(grep "^feature:" "$KANBAN_FILE" | awk '{print $2}')

# Record user feedback in the ticket
printf '\n## Feedback from user\n%s\n' "$USER_FEEDBACK" >> "$KANBAN_FILE"

# Write after-action-report section
WHAT_BUILT=$(awk '/^## What was built/{found=1; next} /^## /{found=0} found{print}' "$KANBAN_FILE" | grep -v '^(builder fills' | grep -v '^$')
HOW_WORKS=$(awk '/^## How it works/{found=1; next} /^## /{found=0} found{print}' "$KANBAN_FILE" | grep -v '^(builder fills' | grep -v '^$')
TESTS=$(grep "^- \[x\]" "$KANBAN_FILE" 2>/dev/null | head -20 || echo "(none recorded)")
LESSONS=$(awk '/^## Lessons learned/{found=1; next} /^## /{found=0} found{print}' "$KANBAN_FILE" | grep -v '^(builder fills' | grep -v '^$')

AAR_FILE="$KANBAN_DIR/aar/$ISSUE-aar.md"
mkdir -p "$KANBAN_DIR/aar"

cat > "$AAR_FILE" << EOF
# After-Action Report — $ISSUE
**Feature:** $FEATURE
**Closed:** $(date '+%Y-%m-%d %H:%M')
**User feedback:** $USER_FEEDBACK

## What was built
$WHAT_BUILT

## How it works
$HOW_WORKS

## Tests verified
$TESTS

## Lessons learned
${LESSONS:-(none recorded)}

## Additional notes
${AAR_NOTES:-(none)}
EOF

echo "After-action report written: $AAR_FILE"

# Append non-obvious lessons to global knowledge/lessons.md
if [ -n "$LESSONS" ]; then
  mkdir -p "$PROJECT_ROOT/knowledge"
  printf '\n---\n### %s — %s (%s)\n%s\n' \
    "$(date '+%Y-%m-%d')" "$ISSUE" "$FEATURE" "$LESSONS" >> "$LESSONS_FILE"
  echo "Lessons appended to knowledge/lessons.md"
fi

# Mark COMPLETE via kanban-update
kanban-update "$ISSUE" "COMPLETE" "Approved by user: $USER_FEEDBACK"

# BFS over dependency graph to check if full cluster is now complete
declare -A visited
queue=("$ISSUE")
visited["$ISSUE"]=1
cluster=("$ISSUE")

while [ ${#queue[@]} -gt 0 ]; do
  current="${queue[0]}"
  queue=("${queue[@]:1}")

  if [ -f "$KANBAN_DIR/$current.md" ]; then
    deps=$(grep "^dependsOn:" "$KANBAN_DIR/$current.md" 2>/dev/null \
      | sed 's/^dependsOn:[[:space:]]*//' | tr ',' '\n' | tr -d ' []"' | grep -v '^$')
    for dep in $deps; do
      if [ -n "$dep" ] && [ -z "${visited[$dep]}" ]; then
        visited[$dep]=1; cluster+=("$dep"); queue+=("$dep")
      fi
    done
  fi

  for f in "$KANBAN_DIR"/*.md; do
    [ -f "$f" ] || continue
    fname=$(basename "$f" .md)
    [[ "$fname" == *-card ]] || [[ "$fname" == *-aar ]] && continue
    [ -n "${visited[$fname]}" ] && continue
    fdeps=$(grep "^dependsOn:" "$f" 2>/dev/null \
      | sed 's/^dependsOn:[[:space:]]*//' | tr ',' '\n' | tr -d ' []"' | grep -v '^$')
    if echo "$fdeps" | grep -qx "$current" 2>/dev/null; then
      visited[$fname]=1; cluster+=("$fname"); queue+=("$fname")
    fi
  done
done

COORDINATOR=$(cat ~/.claude/.coordinator 2>/dev/null)

if [ ${#cluster[@]} -gt 1 ]; then
  ALL_DONE=true
  PENDING=()
  for member in "${cluster[@]}"; do
    [ "$member" = "$ISSUE" ] && continue
    member_status=$(grep "^status:" "$KANBAN_DIR/$member.md" 2>/dev/null | awk '{print $2}')
    if [ "$member_status" != "COMPLETE" ]; then
      ALL_DONE=false; PENDING+=("$member")
    fi
  done

  if $ALL_DONE; then
    KANBAN_PROJECT_ROOT="$PROJECT_ROOT" kanban-generate-card --group "${cluster[@]}"
    GROUP_NAME=$(IFS='+'; echo "${cluster[*]}")
    CARD="$KANBAN_DIR/user-test-cards/${GROUP_NAME}-group-card.md"
    [ -n "$COORDINATOR" ] && tmux send-keys -t "$COORDINATOR" \
      "[GROUP CLOSED: ${cluster[*]}] all approved — integrated card: $CARD" Enter
  else
    PENDING_STR=$(IFS=', '; echo "${PENDING[*]}")
    [ -n "$COORDINATOR" ] && tmux send-keys -t "$COORDINATOR" \
      "[$ISSUE] closed. Cluster pending: [$PENDING_STR]" Enter
  fi
else
  [ -n "$COORDINATOR" ] && tmux send-keys -t "$COORDINATOR" \
    "[$ISSUE] closed. AAR at: $AAR_FILE" Enter
fi
