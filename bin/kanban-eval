#!/usr/bin/env node
// kanban-eval [--json]
// Scores coordinator responsiveness, per-builder adherence, and pipeline health.

const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

const JSON_MODE = process.argv.includes('--json');

const projectRoot = process.env.KANBAN_PROJECT_ROOT || process.cwd();

const kanbanDir = path.join(projectRoot, 'kanban');
const telemetryPath = path.join(kanbanDir, 'telemetry.jsonl');
const coordLogPath = path.join(kanbanDir, 'coordinator-log.jsonl');

const readJsonl = p => fs.existsSync(p)
  ? fs.readFileSync(p, 'utf8').split('\n').filter(Boolean).map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean)
  : [];

const telemetry = readJsonl(telemetryPath);
const coordLog = readJsonl(coordLogPath);

// Load all kanban feature files
const kanbanFiles = fs.existsSync(kanbanDir)
  ? fs.readdirSync(kanbanDir).filter(f => f.endsWith('.md') && !f.includes('card'))
  : [];

// ── COORDINATOR SCORE ──────────────────────────────────────────────────────

const blockEvents = telemetry.filter(e => e.to === 'NEEDS_SETUP');
const resolveEvents = coordLog.filter(e => e.event === 'resolved');

const resolutionTimes = [];
for (const block of blockEvents) {
  const resolve = resolveEvents.find(r => r.feature === block.feature && r.ts > block.ts);
  if (resolve) resolutionTimes.push({ feature: block.feature, ms: resolve.ts - block.ts, blockTs: block.ts, resolveTs: resolve.ts });
}

const avgResolutionMs = resolutionTimes.length
  ? resolutionTimes.reduce((s, r) => s + r.ms, 0) / resolutionTimes.length
  : null;

const unresolved = blockEvents.filter(b =>
  !resolveEvents.some(r => r.feature === b.feature && r.ts > b.ts)
).map(b => b.feature);

// Score: 100 - deductions
// -10 per unresolved block, -5 per block resolved in >30m, -2 per block resolved in >10m
let coordScore = 100;
coordScore -= unresolved.length * 10;
for (const r of resolutionTimes) {
  if (r.ms > 1800000) coordScore -= 5;
  else if (r.ms > 600000) coordScore -= 2;
}
coordScore = Math.max(0, coordScore);

// ── BUILDER ADHERENCE SCORES ───────────────────────────────────────────────

const builderScores = {};

for (const file of kanbanFiles) {
  const feature = file.replace('.md', '');
  const content = fs.readFileSync(path.join(kanbanDir, file), 'utf8');
  const evs = telemetry.filter(e => e.feature === feature).sort((a, b) => a.ts - b.ts);

  const score = { feature, total: 0, max: 0, details: [] };

  const check = (label, points, pass, note) => {
    score.max += points;
    if (pass) { score.total += points; score.details.push({ label, pass: true, points, note }); }
    else score.details.push({ label, pass: false, points: 0, earned: 0, max: points, note });
  };

  // Kanban completeness (filled in sections)
  const builtFilled = !content.includes('(builder fills this in)') && content.match(/## What was built\n([\s\S]+?)(?=\n##)/)?.[1]?.trim().length > 10;
  const howFilled   = content.match(/## How it works\n([\s\S]+?)(?=\n##)/)?.[1]?.trim().length > 10;
  const testsFilled = (content.match(/- \[x\]/g) || []).length > 0;

  check('What was built section filled', 10, builtFilled, builtFilled ? null : 'section left blank or default');
  check('How it works section filled',   10, howFilled,   howFilled   ? null : 'section left blank or default');
  check('Tests recorded (- [x] entries)', 15, testsFilled, testsFilled ? `${(content.match(/- \[x\]/g)||[]).length} tests` : 'no - [x] entries found');

  // Stage discipline: updated kanban at intermediate stages (not just STARTED → COMPLETE)
  const statusSequence = evs.map(e => e.to).filter(s => s !== 'NONE');
  const hasInProgress  = statusSequence.includes('IN_PROGRESS');
  const jumpedToComplete = statusSequence[0] === 'DONE' || (statusSequence[1] === 'DONE' && !hasInProgress);
  check('Updated kanban at intermediate stages', 15, hasInProgress && !jumpedToComplete,
    jumpedToComplete ? 'jumped from STARTED to COMPLETE without IN_PROGRESS updates' : null);

  // Block discipline: NEEDS_SETUP entries have meaningful notes
  const blockNotes = evs.filter(e => e.to === 'NEEDS_SETUP').map(e => e.notes || '');
  const vaguBlocks = blockNotes.filter(n => n.length < 20);
  check('NEEDS_SETUP entries have specific notes', 10,
    blockNotes.length === 0 || vaguBlocks.length === 0,
    vaguBlocks.length > 0 ? `${vaguBlocks.length} block(s) with vague notes` : blockNotes.length === 0 ? 'no blocks (good)' : null);

  // Contract compliance: if dependsOn is set, check for mock usage or contract mention
  const dependsOnLine = content.match(/^dependsOn:\s*(.+)/m)?.[1]?.trim();
  const hasDeps = dependsOnLine && dependsOnLine !== '' && dependsOnLine !== '[]';
  if (hasDeps) {
    const contractMentioned = content.includes('mock') || content.includes('contract') || content.includes('knowledge/contracts');
    check('Contract/mock usage mentioned (has dependsOn)', 15, contractMentioned,
      contractMentioned ? null : 'has dependsOn but no mention of mock or contract in kanban');
  }

  // Completion: did it reach COMPLETE?
  const completed = statusSequence.includes('DONE');
  check('Reached COMPLETE status', 10, completed, completed ? null : 'never marked complete');

  // Rework: check user-test card for "needs work" feedback
  const cardPath = path.join(kanbanDir, 'user-test-cards', `${feature}-card.md`);
  if (fs.existsSync(cardPath)) {
    const cardContent = fs.readFileSync(cardPath, 'utf8');
    const reworkCount = (cardContent.match(/needs work/gi) || []).length;
    const feedbackSection = content.match(/## Feedback from user\n([\s\S]+?)(?=\n##|$)/)?.[1]?.trim();
    const hadRework = reworkCount > 0 || (feedbackSection && feedbackSection.toLowerCase().includes('needs work'));
    check('Passed user test on first attempt', 15, !hadRework, hadRework ? 'user requested rework' : null);
  }

  builderScores[feature] = score;
}

// ── PIPELINE HEALTH ────────────────────────────────────────────────────────

const allEvs = telemetry;
const totalFeatures = Object.keys(builderScores).length;
const completedFeatures = Object.values(builderScores).filter(s => s.details.find(d => d.label.includes('DONE') && d.pass)).length;
const blockedFeatures = [...new Set(allEvs.filter(e => e.to === 'NEEDS_SETUP').map(e => e.feature))].length;
const blockedPct = totalFeatures > 0 ? Math.round((blockedFeatures / totalFeatures) * 100) : 0;

const allStarts    = allEvs.filter(e => e.from === 'NONE').map(e => e.ts);
const allCompletes = allEvs.filter(e => e.to === 'DONE').map(e => e.ts);
const wallMs  = allStarts.length && allCompletes.length ? Math.max(...allCompletes) - Math.min(...allStarts) : null;
const serialMs = Object.values(builderScores).reduce((sum, s) => {
  const feat = s.feature;
  const fevs = allEvs.filter(e => e.feature === feat).sort((a,b) => a.ts-b.ts);
  const start = fevs.find(e => e.from === 'NONE');
  const end   = [...fevs].reverse().find(e => e.to === 'DONE');
  return sum + (start && end ? end.ts - start.ts : 0);
}, 0);
const parallelGain = wallMs && wallMs > 0 ? (serialMs / wallMs).toFixed(2) : null;

const avgAdherence = Object.values(builderScores).length
  ? Math.round(Object.values(builderScores).reduce((s, b) => s + (b.total / Math.max(b.max, 1)) * 100, 0) / Object.values(builderScores).length)
  : null;

const result = {
  coordinator: { score: coordScore, avgResolutionMs, resolutionTimes, unresolved },
  builders: builderScores,
  pipeline: { totalFeatures, completedFeatures, blockedFeatures, blockedPct, wallMs, serialMs, parallelGain, avgAdherence },
};

if (JSON_MODE) { console.log(JSON.stringify(result, null, 2)); process.exit(0); }

// ── HUMAN REPORT ──────────────────────────────────────────────────────────

const fmt = ms => ms == null ? '—' : ms < 60000 ? `${Math.round(ms/1000)}s` : ms < 3600000 ? `${Math.round(ms/60000)}m` : `${(ms/3600000).toFixed(1)}h`;
const bar = (pct, w=20) => { const f = Math.round((pct/100)*w); return '█'.repeat(f) + '░'.repeat(w-f); };

console.log('\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
console.log('FACTORY EVALUATION REPORT');
console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');

console.log('\n── COORDINATOR ──────────────────────────────────────────────');
console.log(`Score              : ${coordScore}/100  ${bar(coordScore)}`);
console.log(`Blocks resolved    : ${resolutionTimes.length} / ${blockEvents.length}`);
console.log(`Avg resolution     : ${fmt(avgResolutionMs)}`);
if (unresolved.length) console.log(`Unresolved blocks  : ${unresolved.join(', ')}  ← action needed`);
for (const r of resolutionTimes) {
  console.log(`  [${r.feature}] resolved in ${fmt(r.ms)}`);
}

console.log('\n── BUILDER ADHERENCE ────────────────────────────────────────');
for (const [name, s] of Object.entries(builderScores)) {
  const pct = Math.round((s.total / Math.max(s.max, 1)) * 100);
  console.log(`\n${name}  ${pct}%  ${bar(pct)}  (${s.total}/${s.max})`);
  for (const d of s.details) {
    const icon = d.pass ? '✓' : '✗';
    const note = d.note ? `  ← ${d.note}` : '';
    console.log(`  ${icon} ${d.label}${note}`);
  }
}

console.log('\n── PIPELINE HEALTH ──────────────────────────────────────────');
console.log(`Features complete  : ${completedFeatures}/${totalFeatures}`);
console.log(`Features blocked   : ${blockedFeatures} (${blockedPct}%)`);
if (parallelGain) console.log(`Parallelism gain   : ${parallelGain}x`);
if (avgAdherence != null) console.log(`Avg adherence      : ${avgAdherence}%  ${bar(avgAdherence)}`);

console.log('\n── RECOMMENDATIONS ──────────────────────────────────────────');
const recs = [];
if (coordScore < 80) recs.push('Coordinator: resolve NEEDS_SETUP pings faster — builders are idle waiting.');
if (unresolved.length) recs.push(`Coordinator: ${unresolved.length} block(s) never resolved — check kanban for ${unresolved.join(', ')}.`);
if (avgAdherence != null && avgAdherence < 70) recs.push('Builders: low adherence overall — handoff docs may be missing info or contracts are too vague.');
const noTests = Object.values(builderScores).filter(s => !s.details.find(d => d.label.includes('Tests') && d.pass));
if (noTests.length) recs.push(`Builders: ${noTests.map(s=>s.feature).join(', ')} shipped without recorded tests.`);
const noStages = Object.values(builderScores).filter(s => !s.details.find(d => d.label.includes('intermediate') && d.pass));
if (noStages.length) recs.push(`Builders: ${noStages.map(s=>s.feature).join(', ')} skipped intermediate kanban updates — harder to diagnose if something goes wrong.`);
if (blockedPct > 40) recs.push('Pipeline: >40% of features blocked — spec contracts or handoff docs need more detail up front.');
if (!recs.length) recs.push('No major issues detected.');
recs.forEach(r => console.log(`  • ${r}`));

console.log('\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n');
