#!/bin/bash
# pipeline-state — durable, external progress tracking for the requirements pipeline.
# State lives in knowledge/pipeline.json, never in an agent's head; any session can be
# killed and re-instantiated from this file (wisdom: deterministic control, durable state).
#
#   pipeline-state set <feature-slug> <stage> [note]
#   pipeline-state get <feature-slug>
#   pipeline-state list
#
# Stages (requirements pipeline, in order):
#   flow_in_progress      PM is walking the user through this feature's flow
#   flow_confirmed        user confirmed the flow; feasibility not yet requested
#   feasibility_pending   dispatched to technical-planning-agent
#   feasibility_ok        planner verdict: feasible as specified
#   feasibility_workaround planner verdict: feasible via workaround preserving the perceived flow
#   feasibility_waived    PM judged the feature has no larger moving pieces; planner not asked
#   feasibility_blocked   planner verdict: infeasible; blocked report sent to PM (PM decides)
#   prd_complete          PRD + flow + acceptance + feasibility all written for this feature
#   handed_off            included in the handoff-to-planner dispatch
# Every set is also appended to kanban/agent-events.jsonl via factory-log for the audit trail.
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="${KANBAN_PROJECT_ROOT:-$(pwd)}"
STATE_FILE="$PROJECT_ROOT/knowledge/pipeline.json"

CMD="$1"; FEATURE="$2"; STAGE="$3"; NOTE="${4:-}"

case "$CMD" in
  set)
    [ -n "$FEATURE" ] && [ -n "$STAGE" ] || { echo "Usage: pipeline-state set <feature-slug> <stage> [note]"; exit 1; }
    mkdir -p "$PROJECT_ROOT/knowledge"
    python3 - "$STATE_FILE" "$FEATURE" "$STAGE" "$NOTE" <<'PY'
import json, sys, os
path, feature, stage, note = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
state = {"features": {}}
if os.path.exists(path):
    with open(path) as f:
        state = json.load(f)
state.setdefault("features", {})
entry = state["features"].setdefault(feature, {})
entry["stage"] = stage
if note:
    entry["note"] = note
with open(path, "w") as f:
    json.dump(state, f, indent=2)
print(f"{feature} -> {stage}")
PY
    KANBAN_PROJECT_ROOT="$PROJECT_ROOT" "$SCRIPT_DIR/factory-log" pipeline_stage feature="$FEATURE" stage="$STAGE" 2>/dev/null || true
    ;;
  get)
    [ -n "$FEATURE" ] || { echo "Usage: pipeline-state get <feature-slug>"; exit 1; }
    python3 - "$STATE_FILE" "$FEATURE" <<'PY'
import json, sys, os
path, feature = sys.argv[1], sys.argv[2]
if not os.path.exists(path):
    print("no-state"); sys.exit(0)
with open(path) as f:
    state = json.load(f)
entry = state.get("features", {}).get(feature)
print(entry["stage"] if entry else "unknown-feature")
PY
    ;;
  list)
    python3 - "$STATE_FILE" <<'PY'
import json, sys, os
path = sys.argv[1]
if not os.path.exists(path):
    print("(no pipeline state yet)"); sys.exit(0)
with open(path) as f:
    state = json.load(f)
for feature, entry in state.get("features", {}).items():
    note = f"  ({entry['note']})" if entry.get("note") else ""
    print(f"{feature}: {entry.get('stage','?')}{note}")
PY
    ;;
  *)
    echo "Usage: pipeline-state set|get|list ..."; exit 1 ;;
esac
