#!/bin/bash
# kanban-create <issue> --feature <name> [options]
#
# A kanban PRIMITIVE. Creates one issue whose frontmatter carries typed LINKS to the
# canonical source docs (intent/build/success_criteria/testing/feasibility/architecture)
# instead of duplicated prose. status starts NOT_STARTED; a port is NOT assigned here
# (kanban-port allocates it when the ticket's validator boots).
#
# For each issue dependency it scaffolds an empty contract stub the architect fills, so
# the dependent issue can build against the interface and mock it.
#
# This is the local-markdown implementation of the issue model. A future abstraction
# layer will let the same primitive target external trackers (Jira/Linear/...) — see KIV.
set -e

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="${KANBAN_PROJECT_ROOT:-$(pwd)}"
KANBAN_DIR="$PROJECT_ROOT/kanban"

ISSUE=""; FEATURE=""; TITLE=""; MILESTONE=""; REPO=""
DEPENDS=""; INFRA=""; NEEDS_USER_TEST="true"; LANDING_URL=""; TARGET_TYPE=""
INTENT=""; BUILD=""; SUCCESS_CRITERIA=""; TESTING=""; FEASIBILITY=""; ARCHITECTURE=""
ADD_REFS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --feature)          FEATURE="$2";          shift 2;;
    --title)            TITLE="$2";            shift 2;;
    --milestone)        MILESTONE="$2";        shift 2;;
    --repo)             REPO="$2";             shift 2;;
    --depends-on)       DEPENDS="$2";          shift 2;;
    --needs-infra)      INFRA="$2";            shift 2;;
    --needs-user-test)  NEEDS_USER_TEST="$2";  shift 2;;
    --landing-url)      LANDING_URL="$2";      shift 2;;
    --target-type)      TARGET_TYPE="$2";      shift 2;;
    --intent)           INTENT="$2";           shift 2;;
    --build)            BUILD="$2";            shift 2;;
    --success-criteria) SUCCESS_CRITERIA="$2"; shift 2;;
    --testing)          TESTING="$2";          shift 2;;
    --feasibility)      FEASIBILITY="$2";      shift 2;;
    --architecture)     ARCHITECTURE="$2";     shift 2;;
    --add-ref)          ADD_REFS+=("$2");      shift 2;;
    --add-refs)
      IFS=',' read -ra _REFS <<< "$2"
      for r in "${_REFS[@]}"; do
        r="$(echo "$r" | xargs)"; [ -n "$r" ] && ADD_REFS+=("$r")
      done
      shift 2;;
    *) [ -z "$ISSUE" ] && ISSUE="$1"; shift;;
  esac
done

if [ -z "$ISSUE" ] || [ -z "$FEATURE" ]; then
  echo "Usage: kanban-create <issue> --feature <name> [--title <text>] [--milestone n] [--repo <path>]"
  echo "       [--depends-on a,b] [--needs-infra \"Stripe account, OPENAI_API_KEY\"]"
  echo "       [--needs-user-test true|false] [--landing-url <url>]"
  echo "       [--target-type web|extension|cli|service|library]"
  echo "       Typed link fields (each takes ONE path to the canonical source doc):"
  echo "       [--intent knowledge/prd/product.md#<feature>] [--build knowledge/spec/<feature>.md]"
  echo "       [--success-criteria knowledge/contracts/acceptance/<feature>.md]"
  echo "       [--testing knowledge/contracts/acceptance/<feature>.md]"
  echo "       [--feasibility knowledge/technical/feasibility/<feature>.md]"
  echo "       [--architecture knowledge/architecture.md]"
  echo "       Overflow links: [--add-ref \"label:path\"]... or [--add-refs \"label:path,label:path\"]"
  exit 1
fi

if [ -n "$TARGET_TYPE" ]; then
  case "$TARGET_TYPE" in
    web|extension|cli|service|library) ;;
    *) echo "Invalid --target-type: $TARGET_TYPE (must be web|extension|cli|service|library)"; exit 1;;
  esac
fi

mkdir -p "$KANBAN_DIR/user-test-cards"
KFILE="$KANBAN_DIR/$ISSUE.md"
if [ -f "$KFILE" ]; then
  echo "Issue already exists: $KFILE (refusing to overwrite)"
  exit 1
fi

# Scaffold one contract stub per issue dependency (architect fills each in)
CONTRACT_REFS=""
if [ -n "$DEPENDS" ]; then
  mkdir -p "$PROJECT_ROOT/knowledge/contracts"
  IFS=',' read -ra DEPS_ARR <<< "$DEPENDS"
  for dep in "${DEPS_ARR[@]}"; do
    dep="$(echo "$dep" | xargs)"
    [ -z "$dep" ] && continue
    CPATH="$PROJECT_ROOT/knowledge/contracts/$ISSUE-$dep.md"
    if [ ! -f "$CPATH" ]; then
      cat > "$CPATH" << CEOF
# Contract: $ISSUE depends on $dep

What $dep produces that $ISSUE consumes. Fill in the exact shape:
- endpoint path / event signature / data model
- request + response schema

The dependent builds against the REAL $dep (which is DONE and merged before it starts); this file is the interface spec, not a mock boundary.
CEOF
    fi
    CONTRACT_REFS="$CONTRACT_REFS knowledge/contracts/$ISSUE-$dep.md"
  done
fi

# Render --add-ref entries ("label:path") into Additional references bullets, e.g.
#   - interface(session-bundle): knowledge/contracts/iface/session-bundle.md
REFS_BLOCK=""
for ref in "${ADD_REFS[@]}"; do
  label="${ref%%:*}"
  rpath="${ref#*:}"
  label="$(echo "$label" | xargs)"; rpath="$(echo "$rpath" | xargs)"
  if [ "$label" = "$ref" ] || [ -z "$rpath" ]; then
    REFS_BLOCK="${REFS_BLOCK}- ${ref}
"
  else
    REFS_BLOCK="${REFS_BLOCK}- ${label}: ${rpath}
"
  fi
done
[ -z "$REFS_BLOCK" ] && REFS_BLOCK="- (none)"

cat > "$KFILE" << EOF
---
issue: $ISSUE
feature: $FEATURE
title: $TITLE
status: NOT_STARTED
milestone: $MILESTONE
repo: $REPO
branch:
worktree:
port:
dependsOn: $DEPENDS
needsInfra: $INFRA
needs_user_test: $NEEDS_USER_TEST
landing_url: $LANDING_URL
test_command:
target_type: $TARGET_TYPE
intent: $INTENT
build: $BUILD
success_criteria: $SUCCESS_CRITERIA
testing: $TESTING
feasibility: $FEASIBILITY
architecture: $ARCHITECTURE
---

## Additional references
${REFS_BLOCK}
## What was built
(builder fills this in)

## How it works
(builder fills this in)

## Tests run
(builder fills this in — use - [x] format)

## Lessons learned
(builder fills this in — non-obvious discoveries only)

## Feedback from user
(none)
EOF

# MISSING-LINK CHECK (stderr, non-fatal):
#   - required critical links (build, success_criteria) must be non-blank
#   - every provided link path must exist on disk relative to PROJECT_ROOT (#anchor stripped)
WARNED=""
check_link() {
  local field="$1" value="$2" required="$3"
  if [ -z "$value" ]; then
    if [ "$required" = "required" ]; then
      echo "⚠ $field: missing" >&2
      WARNED="yes"
    fi
    return 0
  fi
  local fpath="${value%%#*}"
  case "$fpath" in
    \[\[*) return 0;;   # [[module]] backlink — not a file path
  esac
  if [ ! -e "$PROJECT_ROOT/$fpath" ]; then
    echo "⚠ $field: path not found ($value)" >&2
    WARNED="yes"
  fi
  return 0
}
check_link intent           "$INTENT"
check_link build            "$BUILD"            required
check_link success_criteria "$SUCCESS_CRITERIA" required
check_link testing          "$TESTING"
check_link feasibility      "$FEASIBILITY"
check_link architecture     "$ARCHITECTURE"
for ref in "${ADD_REFS[@]}"; do
  rpath="$(echo "${ref#*:}" | xargs)"
  [ "$rpath" = "$ref" ] && continue
  check_link "ref(${ref%%:*})" "$rpath"
done

KANBAN_PROJECT_ROOT="$PROJECT_ROOT" "$SELF_DIR/factory-log" ticket_created issue="$ISSUE" feature="$FEATURE" dependsOn="$DEPENDS"
# Refresh the materialized dependency graph (kanban/graph.json) — nodes + edges for this new ticket.
KANBAN_PROJECT_ROOT="$PROJECT_ROOT" "$SELF_DIR/kanban-graph" --emit 2>/dev/null || true

echo "Created issue: $KFILE"
[ -n "$DEPENDS" ]       && echo "  dependsOn : $DEPENDS"
[ -n "$INFRA" ]         && echo "  needsInfra: $INFRA"
[ -n "$TARGET_TYPE" ]   && echo "  targetType: $TARGET_TYPE"
[ -n "$CONTRACT_REFS" ] && echo "  contracts :$CONTRACT_REFS"
exit 0
