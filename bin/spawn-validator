#!/bin/bash
# spawn-validator <issue>
# Spawns (or re-messages) the ticket's OWN persistent validator session, named val-<issue> and
# running the validator-agent. Called by the kanban on the RUNNING_TESTS transition — the builder
# never spawns the validator itself. Per-ticket + persistent so the validator keeps its context
# (the tests it authored, what failed last round) across re-validation rounds.
#
# Idempotent: first call creates the session + delivers the VALIDATE kickoff; a later call (a new
# round) only re-delivers a re-validate nudge to the existing session. A port is allocated on the
# first boot (kanban-port) and written to the ticket frontmatter.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ISSUE="${1:-}"
PROJECT_ROOT="${KANBAN_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
KANBAN_FILE="$PROJECT_ROOT/kanban/$ISSUE.md"

if [ -z "$ISSUE" ]; then
  echo "Usage: spawn-validator <issue>"; exit 1
fi
if [ ! -f "$KANBAN_FILE" ]; then
  echo "No kanban entry: $KANBAN_FILE"; exit 1
fi

SESSION="val-$ISSUE"
FEATURE=$(grep -m1 "^feature:" "$KANBAN_FILE" | sed 's/^feature:[[:space:]]*//')
PORT=$(KANBAN_PROJECT_ROOT="$PROJECT_ROOT" "$SCRIPT_DIR/kanban-port" "$ISSUE")

EXISTED=1
tmux has-session -t "$SESSION" 2>/dev/null || EXISTED=0

if [ "$EXISTED" = "0" ]; then
  MSG="VALIDATE: $ISSUE as factory_tester. The candidate was programmatically rebased and builder-tested before this message. Read kanban/$ISSUE.md only for runtime state and follow feature_doc and architecture_doc to the immutable product outcomes and technical implementation. Read relevant contracts and required frontend/backend event chains. Author independent tests before reading builder tests. For UI criteria use fresh factory_web_tester subagents with agent-browser. Inspect correlated logs and record evidence per DC-* criterion with criterion-audit, then audit all objective axes. Never edit code, docs/product/**, or the roadmap. Builder defects return programmatically to the builder; planning gaps route to the planner. Only a proven human-held external blocker may set NEEDS_SETUP. Only subjective UX may reach the user."
else
  MSG="RE-VALIDATE: $ISSUE — the builder reports it fixed the last round's defects. Re-run the failed axes plus a regression pass over axes touching the changed code (bring the app up per what was built; port $PORT if it serves one). Re-record axes with 'kanban-audit $ISSUE axis ...', run 'kanban-audit $ISSUE finalize', then route again: overall pass -> 'kanban-update $ISSUE VALIDATED'; builder-defect -> queue defects to the builder ($ISSUE); external -> 'kanban-update $ISSUE NEEDS_SETUP \"...\"'."
fi

KANBAN_PROJECT_ROOT="$PROJECT_ROOT" "$SCRIPT_DIR/spawn-role" \
  --role tester --session "$SESSION" --ticket "$ISSUE" --cwd "$PROJECT_ROOT" \
  --model "${VALIDATOR_MODEL:-gpt-5.6-terra}" --message "$MSG"

echo "Validator session: $SESSION  (issue $ISSUE, port $PORT)  — $([ "$EXISTED" = 0 ] && echo spawned || echo re-messaged)"
