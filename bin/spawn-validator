#!/bin/bash
# spawn-validator <issue>
# Spawns (or re-messages) the ticket's OWN persistent validator session, named val-<issue> and
# running the validator-agent. Called by the kanban on the RUNNING_TESTS transition — the builder
# never spawns the validator itself. Per-ticket + persistent so the validator keeps its context
# (the tests it authored, what failed last round) across re-validation rounds.
#
# Idempotent: first call creates the session + delivers the VALIDATE kickoff; a later call (a new
# round) only re-delivers a re-validate nudge to the existing session. A port is allocated on the
# first boot (kanban-port) and written to the ticket frontmatter.
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ISSUE="$1"
PROJECT_ROOT="${KANBAN_PROJECT_ROOT:-$(cat "$HOME/.claude/.coordinator-root" 2>/dev/null || pwd)}"
KANBAN_FILE="$PROJECT_ROOT/kanban/$ISSUE.md"

if [ -z "$ISSUE" ]; then
  echo "Usage: spawn-validator <issue>"; exit 1
fi
if [ ! -f "$KANBAN_FILE" ]; then
  echo "No kanban entry: $KANBAN_FILE"; exit 1
fi

SESSION="val-$ISSUE"
FEATURE=$(grep -m1 "^feature:" "$KANBAN_FILE" | sed 's/^feature:[[:space:]]*//')
PORT=$(KANBAN_PROJECT_ROOT="$PROJECT_ROOT" "$SCRIPT_DIR/kanban-port" "$ISSUE")

EXISTED=1
if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  EXISTED=0
  tmux new-session -d -s "$SESSION" -c "$PROJECT_ROOT" \
    -e "PATH=$PROJECT_ROOT/bin:$PATH" \
    -e "KANBAN_PROJECT_ROOT=$PROJECT_ROOT" \
    -e "FACTORY_AGENT=validator-agent" \
    -e "VALIDATOR_ISSUE=$ISSUE" \
    -e "CLAUDE_CODE_SUBAGENT_MODEL=${FACTORY_SUBAGENT_MODEL:-sonnet}"
  tmux send-keys -t "$SESSION" "${CLAUDE_BIN:-claude} --dangerously-skip-permissions --model ${VALIDATOR_MODEL:-sonnet} --agent validator-agent" Enter
  # The idle mark is the delivery gate — wait for the TUI to be input-ready before marking idle.
  BOOT_DEADLINE=$(( $(date +%s) + ${AGENT_BOOT_SECONDS:-90} ))
  if [ "${CLAUDE_BIN:-claude}" = "claude" ]; then
    until tmux capture-pane -pJ -t "$SESSION" -S -30 2>/dev/null | grep -qE "bypass permissions|shift\+tab|esc to interrupt"; do
      sleep 2
      [ "$(date +%s)" -ge "$BOOT_DEADLINE" ] && { echo "[spawn-validator] WARNING: $SESSION TUI not ready after ${AGENT_BOOT_SECONDS:-90}s; marking idle anyway"; break; }
    done
  else
    sleep 1
  fi
  KANBAN_PROJECT_ROOT="$PROJECT_ROOT" "$SCRIPT_DIR/agent-state" "$SESSION" idle
  KANBAN_PROJECT_ROOT="$PROJECT_ROOT" "$SCRIPT_DIR/factory-log" agent_spawned agent="$SESSION" 2>/dev/null || true
fi

if [ "$EXISTED" = "0" ]; then
  MSG="VALIDATE: $ISSUE — read kanban/$ISSUE.md (Success criteria / Testing) and knowledge/contracts/acceptance/$FEATURE.md, author your OWN tests from the contract, and run them against the live app on port $PORT (bring it up as the ticket's test_command describes). Write kanban/validation/$ISSUE.md with per-assertion verdicts, each tracing to a contract line. On PASS: run 'kanban-update $ISSUE VALIDATED'. On any builder-defect FAIL: queue the numbered defects to the builder with 'tmux-delegate $ISSUE \"VALIDATION-FAILED: <defects with evidence>. Fix and re-request.\"' and do NOT set a status. Round cap and classification per your agent rules."
else
  MSG="RE-VALIDATE: $ISSUE — the builder reports it fixed the last round's defects. Re-run your tests against the live app on port $PORT, update kanban/validation/$ISSUE.md (bump the round), and route again: PASS -> 'kanban-update $ISSUE VALIDATED'; FAIL -> queue defects to the builder ($ISSUE)."
fi

KANBAN_PROJECT_ROOT="$PROJECT_ROOT" "$SCRIPT_DIR/tmux-delegate" "$SESSION" "$MSG"

echo "Validator session: $SESSION  (issue $ISSUE, port $PORT)  — $([ "$EXISTED" = 0 ] && echo spawned || echo re-messaged)"
