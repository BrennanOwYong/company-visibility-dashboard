#!/bin/bash
# spawn-agent <agent-name> [initial message...]
# Launches a Codex session for a named role,
# in the project root, inside a tmux session, then delivers an optional kickoff
# message through the delegation queue once the session is idle.
# Idempotent: if the session already exists it only (re)delivers the message.
# Unlike spawn-builder there is no worktree/branch — planning agents work in the root.
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AGENT="$1"; shift || true
MSG="$*"
PROJECT_ROOT="${KANBAN_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"

if [ -z "$AGENT" ]; then
  echo "Usage: spawn-agent <agent-name> [message]"
  exit 1
fi

# The agent name becomes a tmux session. Validate it.
case "$AGENT" in -*)
  echo "Usage: spawn-agent <agent-name> [message]"
  echo "Agents available: $(ls "$PROJECT_ROOT/.codex/agents/" 2>/dev/null | sed 's/\.toml$//' | tr '\n' ' ')"
  exit 1;;
esac
# Only enforce the known-agent check when an agents registry actually exists (a real factory
# root). A throwaway/test root with no .claude/agents/ dir is a degraded mode, not an error —
# the dash-prefix guard above still blocks the `--help`-style footgun everywhere.
if [ -d "$PROJECT_ROOT/.codex/agents" ] && [ ! -f "$PROJECT_ROOT/.codex/agents/$AGENT.toml" ]; then
  echo "Unknown agent '$AGENT' — no $PROJECT_ROOT/.codex/agents/$AGENT.toml"
  echo "Agents available: $(ls "$PROJECT_ROOT/.codex/agents/" 2>/dev/null | sed 's/\.toml$//' | tr '\n' ' ')"
  exit 1
fi

if ! tmux has-session -t "$AGENT" 2>/dev/null; then
  # Research/Task subagents run Sonnet regardless of the user-level subagent-model
  # setting (which would force a frontier model onto every fan-out).
  tmux new-session -d -s "$AGENT" -c "$PROJECT_ROOT" \
    -e "PATH=$PROJECT_ROOT/bin:$PATH" \
    -e "KANBAN_PROJECT_ROOT=$PROJECT_ROOT" \
    -e "FACTORY_AGENT=$AGENT"
  tmux send-keys -t "$AGENT" "codex --dangerously-bypass-approvals-and-sandbox -m ${FACTORY_PLANNING_MODEL:-gpt-5.6-sol}" Enter
  # The idle mark IS the delivery gate (inbox-drain only delivers to idle sessions), so it
  # must wait for the TUI to actually be input-ready — a fixed sleep raced cold boots and let
  # messages be typed into a half-started session, where they were silently swallowed.
  BOOT_DEADLINE=$(( $(date +%s) + ${AGENT_BOOT_SECONDS:-90} ))
  sleep 1
  KANBAN_PROJECT_ROOT="$PROJECT_ROOT" "$SCRIPT_DIR/agent-state" "$AGENT" idle
  KANBAN_PROJECT_ROOT="$PROJECT_ROOT" "$SCRIPT_DIR/factory-log" agent_spawned agent="$AGENT"
fi

if [ -n "$MSG" ]; then
  # Port-on-boot (shift-left): a VALIDATE kickoff is the moment the ticket's test port
  # is allocated — validation runs inside IN_PROGRESS, so NEEDS_USER_TESTING is too late and
  # spawn-time would reserve it for an unknown duration. Builder and validator both read
  # the port from the ticket frontmatter.
  VISSUE=$(printf '%s' "$MSG" | sed -n 's/^VALIDATE:[[:space:]]*\([A-Za-z0-9_-]*\).*/\1/p')
  if [ -n "$VISSUE" ] && [ -f "$PROJECT_ROOT/kanban/$VISSUE.md" ]; then
    VPORT=$(KANBAN_PROJECT_ROOT="$PROJECT_ROOT" "$SCRIPT_DIR/kanban-port" "$VISSUE") \
      && echo "[$VISSUE] test port: $VPORT"
  fi
  KANBAN_PROJECT_ROOT="$PROJECT_ROOT" "$SCRIPT_DIR/tmux-delegate" "$AGENT" "$MSG"
fi

echo "Agent session: $AGENT  (tmux attach -t $AGENT)"
