#!/bin/bash
# kanban-dispatch — spawns one builder per NOT_STARTED kanban issue.
#
# Issues are created by the architect via kanban-create (the source of truth); each
# issue file is the builder's brief. spawn-builder is called once per issue and uses
# that issue (it does not overwrite it). Idempotent: an issue whose worktree field is
# already set has been dispatched and is skipped, so this is safe to re-run as the
# architect adds issues.
#
# A port is NOT assigned here (testing-phase resource — set at NEEDS_TESTING). The board
# view is kanban-check; tmux liveness is deliberately not mapped to state (KIV 7).
# Note: the standalone kickoff trigger and pluggable tracker backend are KIV 8 — this
# script is the local-markdown dispatcher.
#
# Usage:
#   kanban-dispatch            dispatch every NOT_STARTED, not-yet-spawned issue
#   kanban-dispatch --dry-run  show what would be dispatched, spawn nothing
#   kanban-dispatch --force    re-spawn even issues that already have a worktree
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="${KANBAN_PROJECT_ROOT:-$(cat "$HOME/.claude/.coordinator-root" 2>/dev/null || pwd)}"
KANBAN_DIR="$PROJECT_ROOT/kanban"

MODE="dispatch"; FORCE="0"
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) MODE="dryrun"; shift;;
    --force)   FORCE="1"; shift;;
    *) shift;;
  esac
done

[ -d "$KANBAN_DIR" ] || { echo "No kanban dir: $KANBAN_DIR"; exit 1; }

fm() { grep "^$2:" "$1" | head -1 | sed "s/^$2:[[:space:]]*//"; }

[ "$MODE" = "dryrun" ] && echo "(dry run — nothing will be spawned)"

DISPATCHED=0; SKIPPED=0
DISPATCH_LOG="$KANBAN_DIR/dispatch-log.jsonl"

for KFILE in "$KANBAN_DIR"/*.md; do
  [ -f "$KFILE" ] || continue
  base=$(basename "$KFILE" .md)
  case "$base" in *-card|*-aar) continue;; esac

  STATUS=$(fm "$KFILE" status)
  [ "$STATUS" = "NOT_STARTED" ] || continue   # only dispatch fresh issues

  ISSUE=$(fm "$KFILE" issue); [ -z "$ISSUE" ] && ISSUE="$base"
  WT=$(fm "$KFILE" worktree)
  if [ -n "$WT" ] && [ "$FORCE" != "1" ]; then
    echo "  • $ISSUE — already dispatched (worktree set) — skipped"; SKIPPED=$((SKIPPED+1)); continue
  fi

  FEATURE=$(fm "$KFILE" feature)
  DEPS=$(fm "$KFILE" dependsOn)
  REPO=$(fm "$KFILE" repo)

  ARGS=("$ISSUE" "$KFILE" --feature "${FEATURE:-$ISSUE}")
  [ -n "$DEPS" ] && ARGS+=(--depends-on "$DEPS")
  [ -n "$REPO" ] && ARGS+=(--repo "$REPO")

  if [ "$MODE" = "dryrun" ]; then
    echo "  → would spawn: $ISSUE  feature:${FEATURE:-$ISSUE}  deps:[${DEPS:-none}]  repo:${REPO:-(project root)}"
    DISPATCHED=$((DISPATCHED+1)); continue
  fi

  echo "  → dispatching $ISSUE ..."
  if ( cd "$PROJECT_ROOT" && KANBAN_PROJECT_ROOT="$PROJECT_ROOT" "$SCRIPT_DIR/spawn-builder.sh" "${ARGS[@]}" ); then
    DISPATCHED=$((DISPATCHED+1))
    TS=$(date +%s%3N 2>/dev/null || echo 0)
    printf '{"ts":%s,"issue":"%s","feature":"%s","dependsOn":"%s"}\n' "$TS" "$ISSUE" "$FEATURE" "$DEPS" >> "$DISPATCH_LOG"
  else
    echo "  ✗ $ISSUE — spawn-builder failed"; SKIPPED=$((SKIPPED+1))
  fi
done

echo ""
echo "Dispatched: $DISPATCHED   Skipped: $SKIPPED"
[ "$MODE" != "dryrun" ] && [ "$DISPATCHED" -gt 0 ] && echo "Run 'kanban-check' for the board."
exit 0
