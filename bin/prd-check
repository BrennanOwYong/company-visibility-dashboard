#!/bin/bash
# prd-check — programmatic completeness gate before the PM->planner handoff.
# Checks EXISTENCE and non-emptiness only; judging content quality is the LLM's job.
# Exit 0: complete. Exit 1: lists every missing artifact.
#
# Required for handoff:
#   knowledge/prd/product.md              the single living PRD for the whole project
#   knowledge/pipeline.json               at least one feature registered via pipeline-state
# Required per feature <slug> in pipeline.json:
#   <slug> appears in product.md          (feature index row / section heading)
#   knowledge/contracts/acceptance/<slug>.md   definition of done
#   stage feasibility_ok | feasibility_workaround | feasibility_waived | prd_complete | handed_off
#   knowledge/technical/feasibility/<slug>.md       required only for ok|workaround (waived = PM judged
#                                         the feature has no larger moving pieces to check)
set -e

PROJECT_ROOT="${KANBAN_PROJECT_ROOT:-$(pwd)}"
cd "$PROJECT_ROOT"

python3 - <<'PY'
import json, os, sys

fail = []

def need_file(path, why):
    ok = os.path.exists(path) and os.path.getsize(path) > 0
    if not ok:
        fail.append(f"MISSING  {path}  ({why})")
    return ok

prd = "knowledge/prd/product.md"
prd_text = ""
if need_file(prd, "the single living PRD: problem, feature index, section per feature, ledger"):
    with open(prd) as f:
        prd_text = f.read()

if not os.path.exists("knowledge/pipeline.json"):
    fail.append("MISSING  knowledge/pipeline.json  (no features registered; PM must run pipeline-state)")
    features = {}
else:
    with open("knowledge/pipeline.json") as f:
        features = json.load(f).get("features", {})
    if not features:
        fail.append("EMPTY    knowledge/pipeline.json  (no features registered)")

OK_STAGES = {"feasibility_ok", "feasibility_workaround", "feasibility_waived", "prd_complete", "handed_off"}
VERDICT_STAGES = {"feasibility_ok", "feasibility_workaround"}
for slug, entry in features.items():
    if prd_text and slug not in prd_text:
        fail.append(f"MISSING  '{slug}' not found in {prd}  (every registered feature needs its section/index row)")
    need_file(f"knowledge/contracts/acceptance/{slug}.md", "definition of done")
    stage = entry.get("stage", "?")
    if stage not in OK_STAGES:
        fail.append(f"STAGE    {slug} is '{stage}'  (needs feasibility ok/workaround, or waived by the PM)")
    if stage in VERDICT_STAGES:
        need_file(f"knowledge/technical/feasibility/{slug}.md", "verdict file from technical-planning-agent")

if fail:
    print("prd-check: NOT READY for handoff\n")
    print("\n".join(fail))
    sys.exit(1)

waived = sum(1 for e in features.values() if e.get("stage") == "feasibility_waived")
print(f"prd-check: READY — {len(features)} feature(s) ({waived} waived), single PRD present, acceptance + dispositions in")
PY
