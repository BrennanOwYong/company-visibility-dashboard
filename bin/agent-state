#!/bin/bash
# agent-state <agent> <idle|busy>
# Records whether an agent can receive a delegated message right now.
# idle = done talking, safe to send. busy = mid-turn, hold.
# Called by the agent's own Stop / UserPromptSubmit hooks and by spawn-builder.
AGENT="$1"
STATE="$2"
ROOT="${KANBAN_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"

if [ -z "$ROOT" ] || [ -z "$AGENT" ] || [ -z "$STATE" ]; then
  exit 0
fi

mkdir -p "$ROOT/.factory/runtime/agents"
TMP="$ROOT/.factory/runtime/agents/$AGENT.state.$$"
printf '%s\n' "$STATE" > "$TMP"
mv "$TMP" "$ROOT/.factory/runtime/agents/$AGENT.state"
