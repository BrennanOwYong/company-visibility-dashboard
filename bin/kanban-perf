#!/usr/bin/env node
// kanban-perf [--json]
// Reads kanban/telemetry.jsonl and prints a timing analysis report.

const fs = require('fs');
const path = require('path');

const JSON_MODE = process.argv.includes('--json');

const projectRoot = process.env.KANBAN_PROJECT_ROOT || process.cwd();

const telemetryPath = path.join(projectRoot, 'kanban', 'telemetry.jsonl');

if (!fs.existsSync(telemetryPath)) {
  console.error('No telemetry file found:', telemetryPath);
  process.exit(0);
}

const events = fs.readFileSync(telemetryPath, 'utf8')
  .split('\n').filter(Boolean)
  .map(line => { try { return JSON.parse(line); } catch { return null; } })
  .filter(Boolean);

// Group events by feature
const features = {};
for (const ev of events) {
  if (!features[ev.feature]) features[ev.feature] = [];
  features[ev.feature].push(ev);
}

// Per-feature stats
const stats = {};
for (const [name, evs] of Object.entries(features)) {
  evs.sort((a, b) => a.ts - b.ts);

  const startEv = evs.find(e => e.from === 'NONE' || e.from === '' || e.to === 'STARTED');
  const completeEv = [...evs].reverse().find(e => e.to === 'COMPLETE');

  const totalMs = (startEv && completeEv) ? completeEv.ts - startEv.ts : null;

  // Blocked time: sum of durations where from=BLOCKED_ON
  let blockedMs = 0;
  let blockCount = 0;
  let inBlockSince = null;
  for (const ev of evs) {
    if (ev.to === 'BLOCKED_ON') { inBlockSince = ev.ts; blockCount++; }
    if (ev.from === 'BLOCKED_ON' && inBlockSince) { blockedMs += ev.ts - inBlockSince; inBlockSince = null; }
  }

  const transitions = evs.map(e => ({ from: e.from, to: e.to, ts: e.ts, notes: e.notes }));

  stats[name] = {
    totalMs,
    blockedMs,
    blockCount,
    activeMs: totalMs != null ? totalMs - blockedMs : null,
    startTs: startEv ? startEv.ts : null,
    completeTs: completeEv ? completeEv.ts : null,
    transitions,
  };
}

if (JSON_MODE) {
  console.log(JSON.stringify(stats, null, 2));
  process.exit(0);
}

// Human-readable report
const fmt = ms => {
  if (ms == null) return '—';
  if (ms < 60000) return `${Math.round(ms / 1000)}s`;
  if (ms < 3600000) return `${Math.round(ms / 60000)}m`;
  return `${(ms / 3600000).toFixed(1)}h`;
};

const ts2time = ts => ts ? new Date(ts).toISOString().slice(11, 16) + 'Z' : '—';

const names = Object.keys(stats);
const col = (s, n) => String(s).padEnd(n);

console.log('\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
console.log('FACTORY PERFORMANCE REPORT');
console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
console.log(col('Feature', 24) + col('Start', 8) + col('Done', 8) + col('Total', 8) + col('Active', 8) + col('Blocked', 10) + 'Blocks');
console.log('─'.repeat(74));

for (const name of names) {
  const s = stats[name];
  console.log(
    col(name, 24) +
    col(ts2time(s.startTs), 8) +
    col(ts2time(s.completeTs), 8) +
    col(fmt(s.totalMs), 8) +
    col(fmt(s.activeMs), 8) +
    col(fmt(s.blockedMs), 10) +
    s.blockCount
  );
}

// Session-level stats
const allStarts = names.map(n => stats[n].startTs).filter(Boolean);
const allCompletes = names.map(n => stats[n].completeTs).filter(Boolean);

if (allStarts.length && allCompletes.length) {
  const wallStart = Math.min(...allStarts);
  const wallEnd = Math.max(...allCompletes);
  const wallMs = wallEnd - wallStart;
  const serialMs = names.reduce((sum, n) => sum + (stats[n].totalMs || 0), 0);
  const parallelGain = serialMs > 0 ? (serialMs / wallMs).toFixed(2) : '—';

  const totalBlocked = names.reduce((sum, n) => sum + stats[n].blockedMs, 0);
  const totalActive = names.reduce((sum, n) => sum + (stats[n].activeMs || 0), 0);
  const blockPct = serialMs > 0 ? Math.round((totalBlocked / serialMs) * 100) : 0;

  console.log('─'.repeat(74));
  console.log(`Wall clock   : ${fmt(wallMs)}   (${ts2time(wallStart)} → ${ts2time(wallEnd)})`);
  console.log(`Serial equiv : ${fmt(serialMs)}`);
  console.log(`Parallelism  : ${parallelGain}x speedup`);
  console.log(`Blocked time : ${fmt(totalBlocked)} across all builders (${blockPct}% of serial total)`);
  console.log(`Active time  : ${fmt(totalActive)}`);
}

// Transition detail per feature
console.log('\n── STAGE BREAKDOWN ──');
for (const name of names) {
  const s = stats[name];
  console.log(`\n${name}`);
  let prev = null;
  for (const t of s.transitions) {
    const dur = prev ? fmt(t.ts - prev.ts) : '';
    const durStr = dur ? `  (+${dur})` : '';
    console.log(`  ${t.from || 'NONE'} → ${t.to}${durStr}${t.notes ? '  ' + t.notes : ''}`);
    prev = t;
  }
}

console.log('\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n');
